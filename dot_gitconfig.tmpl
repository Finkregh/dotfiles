[push]
    default = simple

[credential]
    helper = cache --timeout=28800

[color]
    diff = auto
    status = auto
    branch = auto
    ui = true

[color "diff"]
    whitespace = red reverse

[core]
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    autocrlf = input
    excludesfile = ~/.gitignore_global
    editor = nvim
    quotepath = true
    commitGraph = true
    #pager = delta

[user]
    email = {{ .email | quote }}
    Name = Oluf Lorenzen
    {{ if ne .signingkey "none" }}
    signingkey = {{ .signingkey }}
    {{ end }}

[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    #cp = cherry-pick
    rb = !bash -c 'git fetch && git rebase "origin/$(git branch --show-current)"'
    eat = !bash -c 'git add -p && git absorb --base origin/main && git rebase -i origin/main && git phf'
    df = diff
    lg = log -p
    fixup = commit --amend --no-edit
    ph = push origin HEAD
    phf = push origin HEAD --force-with-lease
    tree = log --graph --pretty=oneline --abbrev-commit --all --decorate
    stree = log --pretty=oneline --topo-order --graph --abbrev-commit
    wdiff = diff --color-words
    wmdiff = diff master --color-words
    wshow = show --color-words
    wmshow = show master --color-words
    merge = merge --ff-only
    pull = pull --rebase
    rbc = rebase --continue
    tt = timetrack
    graphviz = "!f() { echo 'digraph git {' ; git log --pretty='format: %h -> { %p }' \"$@\" | sed 's/[0-9a-f]\\+/\"&\"/g' ; echo '}'; }; %f"
    conflicted = !nvim +Conflicted
    #git graphviz HEAD^^..HEAD | dotty /dev/stdin
    #git graphviz --first-parent master | dotty /dev/stdin
    f = fuzzy
    # show last changed branches and when
    wip = for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)' refs/heads # https://carolynvanslyck.com/blog/2020/12/git-wip/
	
	# Difftastic aliases, so `git dlog` is `git log` with difftastic and so on.
    dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff

    # `git log` with patches shown with difftastic.
    dl = -c diff.external=difft log -p --ext-diff
    # Show the most recent commit with difftastic.
    ds = -c diff.external=difft show --ext-diff
    # `git diff` with difftastic.
    dft = -c diff.external=difft diff

    # from <https://xahteiwi.eu/resources/hints-and-kinks/git-aliases/#git-aliases>
    # List branches by their date of last modification
    recent = branch --sort=-committerdate --format=\"%(committerdate:relative)%09%(refname:short)\"
    # Delete old topic branches that have been merged
    delete-merged-branches = !git branch --merged | grep -Ev '(main|master)' | xargs -prn1 git branch -d
    # Find the origin of a branch point
    oldest-ancestor = !bash -c 'diff -u <(git rev-list --first-parent \"${1:-main}\") <(git rev-list --first-parent \"${2:-HEAD}\") | sed -ne \"s/^ //p\" | head -1' -


[gui]
    fontui   = -family terminus -size 9 -weight normal -slant roman -underline 0 -overstrike 0
    fontdiff = -family terminus -size 9 -weight normal -slant roman -underline 0 -overstrike 0
[mergetool "gvimdiff3"]
    cmd = gvim -f -d -c \"wincmd J\" \"$MERGED\" \"$LOCAL\" \"$BASE\" \"$REMOTE\"
[mergetool "vimdiff3"]
    cmd = vim -f -d -c \"wincmd J\" \"$MERGED\" \"$LOCAL\" \"$BASE\" \"$REMOTE\"

[diff "odf"]
    textconv=odt2txt
[diff "localizablestrings"]
    textconv = "iconv -f utf-16 -t utf-8"
[commit]
    {{ if ne .signingkey "none" }}
    gpgsign = true
    {{ else }}
    gpgsign = false
    {{ end }}
    verbose = true
[icdiff]
    options = --highlight --line-numbers
[fetch]
    prune = true
[pull]
    rebase = true
[rebase]
    autostash = true # stash pending changes and re-apply after rebase
    updateRefs = true
    autosquash = true # if you use commmit --fixup=hash
[gc]
    ; <https://devblogs.microsoft.com/devops/supercharging-the-git-commit-graph/>
    writeCommitGraph = true
[rerere]
    ; Reuse Recorded Resolution
    enabled = true
    autoupdate = true
[init]
    defaultBranch = main
    #templatedir = /Users/c5276249/.local/share/git/template
[delta]
    plus-color = "#012800"
    minus-color = "#340001"
    syntax-theme = Monokai Extended
[interactive]
    #diffFilter = delta --color-only
[mergetool "vim-conflicted"]
    cmd = nvim +Conflicted
[merge]
    tool = nvim-conflicted

[include]
    path = "~/work/.git-maintenance"
